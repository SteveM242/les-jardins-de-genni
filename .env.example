# Copiez ce fichier en .env pour le développement local (jamais commité).
# En production (Railway), ces valeurs se règlent dans les variables d'environnement du service.

# --- Obligatoires ---
# Base Postgres (Railway fournit DATABASE_URL automatiquement si Postgres est lié au service).
DATABASE_URL=postgres://user:password@localhost:5432/genni
# Secret de signature des sessions. OBLIGATOIRE en production (le serveur refuse de démarrer sans).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Compte admin (Espace Genni) ---
# Créé/synchronisé au démarrage. Changer ADMIN_PASSWORD déconnecte les sessions admin existantes.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Emails (optionnel : sans SMTP les commandes sont seulement enregistrées en base) ---
ORDER_SMTP_HOST=
ORDER_SMTP_PORT=587
ORDER_SMTP_SECURE=false
ORDER_SMTP_USER=
ORDER_SMTP_PASS=
# Adresse qui reçoit chaque nouvelle commande.
ORDER_NOTIFY_EMAIL=
# Expéditeur des emails (par défaut : ORDER_NOTIFY_EMAIL).
ORDER_FROM_EMAIL=

# --- Divers ---
PORT=4173
# URL publique du site (sitemap, aperçus de partage). Par défaut : déduite de la requête.
SITE_URL=
# Origines supplémentaires autorisées pour les requêtes d'écriture (séparées par des virgules).
ALLOWED_ORIGINS=
# Mettre à "require" si la base Postgres exige SSL.
PGSSLMODE=
NODE_ENV=development
